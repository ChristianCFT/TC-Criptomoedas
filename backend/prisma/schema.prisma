// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int        @id @default(autoincrement())
  nome      String
  email     String     @unique
  senha     String

  carteiras Carteira[]

  createdAt DateTime @default(now())
}


model Carteira {
  id        Int       @id @default(autoincrement())
  nome      String

  usuarioId Int
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  ativos    CarteiraCripto[]

  createdAt DateTime @default(now())
}


model Criptomoeda {
  id              Int              @id @default(autoincrement())
  nome            String
  simbolo         String           @unique

  precoAtual      Float
  variacao24h     Float?

  ativos          CarteiraCripto[]

  updatedAt       DateTime @updatedAt
}


model CarteiraCripto {
  id          Int @id @default(autoincrement())

  carteiraId Int
  criptoId   Int

  carteira   Carteira     @relation(fields: [carteiraId], references: [id])
  cripto     Criptomoeda  @relation(fields: [criptoId], references: [id])

  quantidade          Float
  precoMedioCompra    Float

  createdAt DateTime @default(now())


  @@unique([carteiraId, criptoId])
}
